<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.presentation" office:version="1.2">
 <office:automatic-styles>
  <style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:background-size="border" draw:fill="solid" draw:fill-color="#F7F9FC"/></style:style>
  <style:style style:name="title" style:family="paragraph"><style:paragraph-properties fo:text-align="left"/><style:text-properties fo:font-size="25pt" fo:font-weight="bold" fo:color="#112A46"/></style:style>
  <style:style style:name="subtitle" style:family="paragraph"><style:text-properties fo:font-size="13pt" fo:color="#52677D"/></style:style>
  <style:style style:name="cardtitle" style:family="paragraph"><style:text-properties fo:font-size="16pt" fo:font-weight="bold" fo:color="#FFFFFF"/></style:style>
  <style:style style:name="body" style:family="paragraph"><style:paragraph-properties fo:line-height="120%"/><style:text-properties fo:font-size="13pt" fo:color="#18334F"/></style:style>
  <style:style style:name="small" style:family="paragraph"><style:text-properties fo:font-size="10pt" fo:color="#52677D"/></style:style>
  <style:style style:name="formula" style:family="paragraph"><style:text-properties fo:font-size="16pt" fo:font-weight="bold" fo:color="#0D5B8C"/></style:style>
 </office:automatic-styles>
 <office:body><office:presentation>
  <draw:page draw:name="Slide 1" draw:style-name="dp1" draw:master-page-name="Default">
   <draw:frame draw:style-name="fr" svg:x="0.8cm" svg:y="0.55cm" svg:width="24.4cm" svg:height="1.3cm"><draw:text-box><text:p text:style-name="title">SS_Flow Adapter：以多视图证据约束 TRELLIS 生成</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="0.85cm" svg:y="1.75cm" svg:width="24cm" svg:height="0.8cm"><draw:text-box><text:p text:style-name="subtitle">设计目标：冻结 VGGT 与 TRELLIS 主干，仅学习可信、局部、受限的速度残差。</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="0.9cm" svg:y="3.0cm" svg:width="4.7cm" svg:height="3.5cm" draw:fill="solid" draw:fill-color="#DCECF7" draw:stroke="solid" svg:stroke-color="#8AB7D3"/><draw:frame svg:x="1.25cm" svg:y="3.35cm" svg:width="4.0cm" svg:height="2.8cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#12547D">多视图观测</text:span></text:p><text:p text:style-name="body">RGB / mask</text:p><text:p text:style-name="body">相机参数</text:p><text:p text:style-name="body">VGGT 深度、点图、特征</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="5.75cm" svg:y="4.2cm" svg:width="1.4cm" svg:height="0.7cm"><draw:text-box><text:p text:style-name="formula">→</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="7.1cm" svg:y="3.0cm" svg:width="5.3cm" svg:height="3.5cm" draw:fill="solid" draw:fill-color="#DFF2E8" draw:stroke="solid" svg:stroke-color="#78BD99"/><draw:frame svg:x="7.45cm" svg:y="3.35cm" svg:width="4.6cm" svg:height="2.8cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#146B47">GeoSS：结构证据</text:span></text:p><text:p text:style-name="body">坐标对齐 → 动态锚点</text:p><text:p text:style-name="body">射线占据 / 自由空间证据</text:p><text:p text:style-name="body">跨视图融合与置信度</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="12.55cm" svg:y="4.2cm" svg:width="1.4cm" svg:height="0.7cm"><draw:text-box><text:p text:style-name="formula">→</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="13.9cm" svg:y="3.0cm" svg:width="4.9cm" svg:height="3.5cm" draw:fill="solid" draw:fill-color="#FCEBCB" draw:stroke="solid" svg:stroke-color="#D7A74B"/><draw:frame svg:x="14.25cm" svg:y="3.35cm" svg:width="4.2cm" svg:height="2.8cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#8B5A07">TRELLIS Flow</text:span></text:p><text:p text:style-name="body">SS：稠密结构速度</text:p><text:p text:style-name="body">SLAT：稀疏外观速度</text:p><text:p text:style-name="body">提供冻结的生成先验</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="18.95cm" svg:y="4.2cm" svg:width="1.4cm" svg:height="0.7cm"><draw:text-box><text:p text:style-name="formula">→</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="20.3cm" svg:y="3.0cm" svg:width="4.7cm" svg:height="3.5cm" draw:fill="solid" draw:fill-color="#E9E1F7" draw:stroke="solid" svg:stroke-color="#AA8BD3"/><draw:frame svg:x="20.65cm" svg:y="3.35cm" svg:width="4.0cm" svg:height="2.8cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#623A91">受控残差</text:span></text:p><text:p text:style-name="body">高置信区域校正</text:p><text:p text:style-name="body">低置信区域保留先验</text:p><text:p text:style-name="body">输出结构与外观资产</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="1.1cm" svg:y="7.2cm" svg:width="23.8cm" svg:height="1.8cm"><draw:text-box><text:p text:style-name="formula">v = v_base + 时间门控 × 证据置信度 × 信赖域内的残差</text:p><text:p text:style-name="small">核心原则：不替代 TRELLIS，而是在观测充分时对其 Flow 轨迹进行可控校正。</text:p></draw:text-box></draw:frame>
  </draw:page>
  <draw:page draw:name="Slide 2" draw:style-name="dp1" draw:master-page-name="Default">
   <draw:frame svg:x="0.8cm" svg:y="0.55cm" svg:width="24cm" svg:height="1.3cm"><draw:text-box><text:p text:style-name="title">SS / GeoSS：用稀疏射线证据控制稠密结构 Flow</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="0.85cm" svg:y="1.75cm" svg:width="24cm" svg:height="0.8cm"><draw:text-box><text:p text:style-name="subtitle">“先在锚点上聚合几何，再由体素查询附近锚点”，兼顾三维约束与计算效率。</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="0.9cm" svg:y="3.0cm" svg:width="5.7cm" svg:height="4.6cm" draw:fill="solid" draw:fill-color="#DFF2E8" draw:stroke="solid" svg:stroke-color="#78BD99"/><draw:frame svg:x="1.2cm" svg:y="3.35cm" svg:width="5.1cm" svg:height="3.9cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#146B47">1. 建立可信几何证据</text:span></text:p><text:p text:style-name="body">• Sim(3) 对齐 VGGT 点图与已知相机</text:p><text:p text:style-name="body">• 混合锚点：全局 learnable + 表面 + 边界/不确定点</text:p><text:p text:style-name="body">• 投影每个锚点到各视图，判断占据、自由空间与冲突</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="6.75cm" svg:y="4.85cm" svg:width="1.2cm" svg:height="0.7cm"><draw:text-box><text:p text:style-name="formula">→</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="7.9cm" svg:y="3.0cm" svg:width="5.7cm" svg:height="4.6cm" draw:fill="solid" draw:fill-color="#DCECF7" draw:stroke="solid" svg:stroke-color="#8AB7D3"/><draw:frame svg:x="8.2cm" svg:y="3.35cm" svg:width="5.1cm" svg:height="3.9cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#12547D">2. 跨视图融合与校准</text:span></text:p><text:p text:style-name="body">• 每个锚点仅注意自己的多视图证据</text:p><text:p text:style-name="body">• 输出占据概率、自由证据与不确定度</text:p><text:p text:style-name="body">• 有效视图少或证据冲突时，几何置信度自动降低</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="13.75cm" svg:y="4.85cm" svg:width="1.2cm" svg:height="0.7cm"><draw:text-box><text:p text:style-name="formula">→</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="14.9cm" svg:y="3.0cm" svg:width="10.1cm" svg:height="4.6cm" draw:fill="solid" draw:fill-color="#E9E1F7" draw:stroke="solid" svg:stroke-color="#AA8BD3"/><draw:frame svg:x="15.25cm" svg:y="3.35cm" svg:width="9.4cm" svg:height="3.9cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#623A91">3. 局部速度校正</text:span></text:p><text:p text:style-name="body">• 每个 SS 体素只查询 K 个最近锚点，而非全局注意力</text:p><text:p text:style-name="body">• 残差受锚点置信度、时间门控和信赖域共同限制</text:p><text:p text:style-name="formula">v_SS = v_base + α(t) · c_token · clipτ(Δv)</text:p><text:p text:style-name="body">• 低置信、无观测或冲突区域退回冻结 TRELLIS 先验</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="1.15cm" svg:y="8.05cm" svg:width="23.5cm" svg:height="1.0cm"><draw:text-box><text:p text:style-name="small">收益：显式利用 mask / 深度 / 投影约束空空间和表面位置，同时避免“稠密体素 × 全图 token”的显存爆炸。</text:p></draw:text-box></draw:frame>
  </draw:page>
  <draw:page draw:name="Slide 3" draw:style-name="dp1" draw:master-page-name="Default">
   <draw:frame svg:x="0.8cm" svg:y="0.55cm" svg:width="24cm" svg:height="1.3cm"><draw:text-box><text:p text:style-name="title">SLAT 与训练：几何可信后，再进行外观修正</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="0.85cm" svg:y="1.75cm" svg:width="24cm" svg:height="0.8cm"><draw:text-box><text:p text:style-name="subtitle">SLAT 仅处理 TRELLIS 的 active voxel；训练按“证据 → 结构速度 → 外观速度”逐级进行。</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="0.9cm" svg:y="3.0cm" svg:width="8.0cm" svg:height="4.4cm" draw:fill="solid" draw:fill-color="#FCEBCB" draw:stroke="solid" svg:stroke-color="#D7A74B"/><draw:frame svg:x="1.25cm" svg:y="3.35cm" svg:width="7.3cm" svg:height="3.7cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#8B5A07">GeoVis-SLAT：外观条件与速度残差</text:span></text:p><text:p text:style-name="body">• 将每个 active voxel 投影到多视图，采样 RGB、特征、深度、mask</text:p><text:p text:style-name="body">• 以可见性、遮挡、深度残差和跨视图外观冲突计算可靠性</text:p><text:p text:style-name="body">• 对齐同一 voxel 的条件 token，预测外观 latent 的局部修正</text:p><text:p text:style-name="formula">v_SLAT = v_base + β(t) · c_SLAT · c_SS · gate · Δv</text:p></draw:text-box></draw:frame>
   <draw:rect svg:x="9.25cm" svg:y="3.0cm" svg:width="15.75cm" svg:height="4.4cm" draw:fill="solid" draw:fill-color="#DCECF7" draw:stroke="solid" svg:stroke-color="#8AB7D3"/><draw:frame svg:x="9.6cm" svg:y="3.35cm" svg:width="15.0cm" svg:height="3.7cm"><draw:text-box><text:p text:style-name="cardtitle"><text:span fo:color="#12547D">三阶段训练策略（主干始终冻结）</text:span></text:p><text:p text:style-name="body">阶段 1｜GeoSS 证据学习：占据 / Dice、射线自由空间、投影一致性、置信度校准。</text:p><text:p text:style-name="body">阶段 2｜SS 速度 adapter：Flow Matching 残差监督 + 速度正则 + 低置信先验保持。</text:p><text:p text:style-name="body">阶段 3｜SLAT adapter：稀疏 Flow Matching + 多视图一致性 + 外观/可见性监督。</text:p><text:p text:style-name="body">可选 Phase 2｜经冻结 SLAT decoder 渲染，以 RGB、mask、感知和几何误差反传至 adapter。</text:p></draw:text-box></draw:frame>
   <draw:frame svg:x="1.15cm" svg:y="8.05cm" svg:width="23.5cm" svg:height="1.0cm"><draw:text-box><text:p text:style-name="small">关键约束：证据可靠性、修正需求与残差不确定性分别建模；因此模型不会将“看得清”误判为“必须大幅修改”。</text:p></draw:text-box></draw:frame>
  </draw:page>
 </office:presentation></office:body>
</office:document>
